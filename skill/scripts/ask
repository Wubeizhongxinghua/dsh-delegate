#!/bin/sh
set -eu
skill_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
# nvm is commonly not initialized for noninteractive shells.
if ! command -v dsh >/dev/null 2>&1 && [ -d "${NVM_DIR:-$HOME/.nvm}/versions/node" ]; then
  for dir in "${NVM_DIR:-$HOME/.nvm}"/versions/node/*/bin; do
    if [ -x "$dir/dsh" ]; then PATH="$dir:$PATH"; export PATH; break; fi
  done
fi
if ! command -v dsh >/dev/null 2>&1; then echo 'dsh not found. Install dsh and make it available in PATH.' >&2; exit 1; fi
if [ -z "${DEEPSEEK_API_KEY:-}" ]; then
  key_file="${DSH_DELEGATE_KEY_FILE:-$HOME/.config/codex-dsh/api-key}"
  if [ ! -r "$key_file" ]; then echo 'Set DEEPSEEK_API_KEY or securely store it in ~/.config/codex-dsh/api-key (chmod 600).' >&2; exit 1; fi
  DEEPSEEK_API_KEY=$(cat "$key_file")
  export DEEPSEEK_API_KEY
fi
python3 "$skill_dir/scripts/prepare-profile.py"
exec dsh --profile codex-delegate --patch "$skill_dir/patch.yml" -
